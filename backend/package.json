{
  "name": "expense-tracker-backend",
  "version": "1.0.0",
  "description": "REST API for Expense Tracker application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "npx prisma migrate dev",
